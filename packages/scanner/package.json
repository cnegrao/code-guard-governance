{
  "name": "@council/scanner",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@council/canonical-contracts": "^0.1.0"
  },
  "scripts": {
    "test:path-policy": "tsx --test --test-isolation=none test/discovery-validation-lab/tests/path-policy.test.ts",
    "test:validation-lab": "tsx --test --test-isolation=none test/discovery-validation-lab/tests/*.test.ts",
    "test:discovery-engine": "tsx --test --test-isolation=none test/discovery-engine/*.test.ts",
    "typecheck:validation-lab": "tsc --noEmit -p tsconfig.validation-lab.json",
    "typecheck:discovery-engine": "tsc --noEmit -p tsconfig.discovery-engine.json",
    "typecheck": "tsc --noEmit"
  }
}
