{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
